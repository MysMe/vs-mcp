<?xml version="1.0" encoding="utf-8"?>
<!--
  Command table: one Tools-menu entry that opens the status popup.
-->
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Include href="KnownImageIds.vsct" />

  <Commands package="guidVsDebugMcpPackage">
    <Groups>
      <Group guid="guidVsDebugMcpCmdSet" id="VsDebugMcpMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidVsDebugMcpCmdSet" id="ShowStatusId" priority="0x0100" type="Button">
        <Parent guid="guidVsDebugMcpCmdSet" id="VsDebugMcpMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="StatusInformation" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Claude Debug MCP Status...</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidVsDebugMcpPackage" value="{798e095b-5e74-4a07-bdf0-500d897ef746}" />
    <GuidSymbol name="guidVsDebugMcpCmdSet" value="{539df883-955a-4653-b639-0999a0300b40}">
      <IDSymbol name="VsDebugMcpMenuGroup" value="0x1020" />
      <IDSymbol name="ShowStatusId" value="0x0100" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
