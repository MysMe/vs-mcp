<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="VsDebugMcp.798e095b-5e74-4a07-bdf0-500d897ef746" Version="0.1.0" Language="en-US" Publisher="MysMe" />
    <DisplayName>Claude Debug MCP for Visual Studio</DisplayName>
    <Description xml:space="preserve">A lean fork of Claude Code for Visual Studio (firish/claude_code_vs) that keeps only the debugger: a vs-debug MCP server that lets the claude CLI read and drive the Visual Studio debugger (state, locals, threads, stepping, breakpoints, attach, data breakpoints, ClrMD heap/deadlock/async diagnostics). No diff, panel, notifications or screen capture. Requires the Claude Code CLI. Unofficial, not affiliated with Anthropic.</Description>
    <MoreInfo>https://github.com/MysMe/vs-mcp</MoreInfo>
    <Icon>Resources\icon.png</Icon>
    <PreviewImage>Resources\preview.png</PreviewImage>
    <Tags>claude, claude code, mcp, debugger, c#</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <!-- Experimental (1.14.3): the extension is managed/AnyCPU and the reflected VS surfaces are the
         host's own, so ARM64 devenv runs it natively. x64-only pieces (the bundled ClrMD worker, managed
         data breakpoints) refuse with clear messages at runtime rather than failing confusingly. -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.8,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.14,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    <!-- The Concord data-breakpoint engine component (compiled .vsdconfig rides in via the
         DataBpComponent ProjectReference output group). -->
    <Asset Type="DebuggerEngineExtension" Path="ClaudeCodeVS.DataBpComponent.vsdconfig" />
  </Assets>
</PackageManifest>
